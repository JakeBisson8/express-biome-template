{
  "name": "express-biome-template",
  "version": "1.0.0",
  "description": "An express template using TypeScript and BiomeJS",
  "license": "MIT",
  "author": "Jake Bisson",
  "main": "index.ts",
  "scripts": {
    "build": "tsc",
    "start": "dotenvx run -- cross-env NODE_ENV=production node ./dist/index.js",
    "dev": "dotenvx run -- cross-env NODE_ENV=development node --watch -r ts-node/register ./src/index.ts",
    "test": "echo \"Error: no test specified\" && exit 1",
    "format": "biome format src/ test/ --write",
    "lint": "biome lint src/ test/",
    "lint:fix": "biome lint src/ test/ --fix",
    "check": "biome check src/ test/",
    "check:fix": "biome check src/ test/ --fix",
    "check:staged": "biome check src/ test/ --staged",
    "check:staged:fix": "biome check src/ test/ --staged --fix --files-ignore-unknown=true --no-errors-on-unmatched"
  },
  "devDependencies": {
    "@biomejs/biome": "2.1.2",
    "@types/express": "^5.0.3",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.1.0",
    "cross-env": "^10.0.0",
    "lefthook": "^1.12.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@dotenvx/dotenvx": "^1.48.4",
    "express": "^5.1.0",
    "morgan": "^1.10.1",
    "winston": "^3.17.0"
  }
}
