{
  "name": "express-biome-template",
  "version": "1.0.0",
  "description": "An express template using TypeScript and BiomeJS",
  "license": "MIT",
  "author": "Jake Bisson",
  "main": "index.ts",
  "scripts": {
    "build": "tsc",
    "test": "echo \"Error: no test specified\" && exit 1",
    "format": "biome format src/ test/ --write",
    "lint": "biome lint src/ test/",
    "lint:fix": "biome lint src/ test/ --fix",
    "check": "biome check src/ test/",
    "check:fix": "biome check src/ test/ --fix",
    "check:staged": "biome check src/ test/ --staged",
    "check:staged:fix": "biome check src/ test/ --staged --fix"
  },
  "devDependencies": {
    "@biomejs/biome": "2.1.2",
    "@types/node": "^24.1.0",
    "typescript": "^5.8.3"
  }
}
