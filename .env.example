# HTTP / HTTPS
HTTP_PORT=80
HTTPS_PORT=443
HTTP_ENABLED="true"
HTTPS_ENABLED="false"

# SSL / TLS
SSL_CERTIFICATE_FILE="cert.crt"
SSL_KEY_FILE="key.key"
SSL_MIN_VERSION="TLSv1.3"
SSL_MAX_VERSION="TLSv1.3"
SSL_CIPHERS="TLS_AES_128_GCM_SHA256:TLS_AES_256_GCM_SHA384:TLS_CHACHA20_POLY1305_SHA256"
ECDH_CURVES="X25519:prime256v1:secp384r1"
DH_PARAM_FILE="dhparam.pem"

# HSTS
HSTS_MAX_AGE=63072000
HSTS_INCLUDE_SUBDOMAINS="true"
HSTS_PRELOAD="true"

# Log files
LOG_FILE="combined.log"
ERROR_LOG_FILE="error.log"